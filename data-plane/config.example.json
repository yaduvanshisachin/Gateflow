{
  "version": 1,
  "services": [
    {
      "name": "users-svc",
      "lb_algorithm": "round_robin",
      "targets": [
        { "url": "http://127.0.0.1:9001" },
        { "url": "http://127.0.0.1:9002" }
      ]
    },
    {
      "name": "orders-svc",
      "lb_algorithm": "weighted",
      "request_timeout_ms": 10000,
      "targets": [
        { "url": "http://127.0.0.1:9003", "weight": 3 },
        { "url": "http://127.0.0.1:9004", "weight": 1 }
      ]
    },
    {
      "name": "slow-svc",
      "response_header_timeout_ms": 1000,
      "targets": [{ "url": "http://127.0.0.1:9005" }]
    }
  ],
  "routes": [
    {
      "name": "users-api",
      "service": "users-svc",
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "paths": [{ "type": "prefix", "value": "/api/users" }],
      "strip_prefix": true
    },
    {
      "name": "orders-api",
      "service": "orders-svc",
      "paths": [{ "type": "prefix", "value": "/api/orders" }]
    },
    {
      "name": "slow",
      "service": "slow-svc",
      "paths": [{ "type": "exact", "value": "/slow" }]
    }
  ]
}
